# Copy to .env (never commit .env). Names only - no real secrets here.
# PowerShell alternative for the key:  $env:GROQ_API_KEY = "gsk_..."

# --- LLM (Groq) ---------------------------------------------------------------
GROQ_API_KEY=
# Model IDs change over time. List what YOUR key can use:  python -m app.cli verify --list-models
GROQ_MODEL=llama-3.3-70b-versatile
# Judge model: use a DIFFERENT model family than GROQ_MODEL where possible (reduces self-enhancement bias)
JUDGE_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT=30
GROQ_MAX_RETRIES=3
MAX_CONTEXT_TOKENS=3000
MAX_OUTPUT_TOKENS=512

# --- Vector store (ChromaDB, persistent) ---------------------------------------
CHROMA_PERSIST_DIRECTORY=chroma_data
CHROMA_COLLECTION_NAME=rag_chunks

# --- Embeddings ----------------------------------------------------------------
# sentence-transformers (default, real semantic model) | hash (offline lexical fallback, NOT for reporting)
EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
EMBEDDING_BATCH_SIZE=32

# --- Chunking (unit = whitespace-delimited word) ---------------------------------
CHUNK_SIZE=180
CHUNK_OVERLAP=30

# --- Retrieval / abstention -------------------------------------------------------
TOP_K=5
MAX_TOP_K=50
# Cosine-similarity gate. Model-specific! 0.30 is an UNCALIBRATED starting point for MiniLM:
# run `python -m app.cli calibrate` and set the recommended value.
MIN_RELEVANCE_SCORE=0.30

# --- Ops --------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_QUERY_TEXT=false
# Comma-separated folders (relative to project root) that POST /ingest may read
ALLOWED_INGEST_ROOTS=data

# --- Evaluation / benchmark ---------------------------------------------------------
EVALUATION_DATASET_PATH=data/evaluation
EVALUATION_OUTPUT_DIR=results
SAMPLE_DOCUMENTS_DIR=data/sample_documents
BENCHMARK_WARMUP=5
BENCHMARK_REPEATS=5
